<Window x:Class="FuriXeus.Tuber.Native.AssetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FURI//CORE Asset Manager"
        Icon="Assets/FuriCore.ico"
        Width="980" Height="760"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B0A0F"
        Foreground="#F7F5FA">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1A1720"/>
      <Setter Property="Foreground" Value="#F7F5FA"/>
      <Setter Property="BorderBrush" Value="#393340"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="Background" Value="#18151D"/>
      <Setter Property="Foreground" Value="#F7F5FA"/>
      <Setter Property="BorderBrush" Value="#3A3441"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="CHARACTER ASSET MANAGER" Foreground="#FF2D8B" FontFamily="Consolas" FontWeight="Bold" FontSize="18"/>
        <TextBlock Text="Folder skin first • per-emotion overrides on top • built-in Critter always remains the fallback"
                   Foreground="#958E9D" FontFamily="Consolas" FontSize="10" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="DONE" Click="DoneButton_Click" Padding="18,8"/>
    </Grid>

    <Border Grid.Row="1" Background="#111018" BorderBrush="#2A2631" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="BASE SKIN FOLDER" Foreground="#FF8A1F" FontFamily="Consolas" FontWeight="Bold" FontSize="10"/>
          <TextBlock x:Name="FolderPathText" Text="Built-in Chaos Critter" Foreground="#C8C3CD" FontFamily="Consolas" FontSize="10" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="1" Content="CHOOSE FOLDER" Click="ChooseFolderButton_Click"/>
        <Button Grid.Column="2" Content="CLEAR FOLDER" Click="ClearFolderButton_Click"/>
        <Button Grid.Column="3" Content="RELOAD" Click="ReloadButton_Click"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#0F0E14" BorderBrush="#24212B" BorderThickness="1" CornerRadius="14" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="AssetItemsControl">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#141219" BorderBrush="#25212B" BorderThickness="0,0,0,1" Padding="10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <Border Width="58" Height="58" CornerRadius="10" Background="#09080C" BorderBrush="#302A35" BorderThickness="1" VerticalAlignment="Center">
                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="2"/>
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                    <TextBlock Text="{Binding Label}" Foreground="#F7F5FA" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{Binding FileName}" Foreground="#756F7B" FontFamily="Consolas" FontSize="9" Margin="0,3,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding SourceText}" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold"/>
                    <TextBlock Text="{Binding EffectivePath}" Foreground="#8D8793" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding EffectivePath}"/>
                  </StackPanel>

                  <Button Grid.Column="3" Style="{StaticResource SmallButton}" Content="CHOOSE FILE" Tag="{Binding RelativePath}" Click="ChooseAssetButton_Click"/>
                  <Button Grid.Column="4" Style="{StaticResource SmallButton}" Content="CLEAR OVERRIDE" Tag="{Binding RelativePath}" Click="ClearAssetButton_Click"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SummaryText" Text="" Foreground="#817B88" FontFamily="Consolas" FontSize="9.5" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="CLEAR ALL FILE OVERRIDES" Click="ClearAllOverridesButton_Click"/>
      <Button Grid.Column="2" Content="OPEN SKIN FOLDER" Click="OpenSkinFolderButton_Click"/>
    </Grid>
  </Grid>
</Window>
