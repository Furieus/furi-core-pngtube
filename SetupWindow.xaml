<Window x:Class="FuriXeus.Tuber.Native.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FURI//CORE Setup"
        Icon="Assets/FuriCore.ico"
        Width="1080" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <Window.Resources>
    <Style x:Key="SetupTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F7F5FA"/>
      <Setter Property="Background" Value="#14131B"/>
      <Setter Property="BorderBrush" Value="#34303D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="CaretBrush" Value="#FF2D8B"/>
    </Style>
    <Style x:Key="StepCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Background" Value="#0F0E14"/>
      <Setter Property="BorderBrush" Value="#25222D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="TrainingCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="#111018"/>
      <Setter Property="BorderBrush" Value="#2A2631"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="30" Background="#09090D" BorderBrush="#2B2732" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.7"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="76"/>
      </Grid.RowDefinitions>

      <!-- borderless drag rail -->
      <Grid Grid.Row="0" Margin="24,0,18,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5" Background="#FF2D8B" Margin="0,0,10,0">
            <Border.Effect><DropShadowEffect Color="#FF2D8B" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
          </Border>
          <TextBlock Text="FURI//CORE" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="SETUP / REACTION TRAINER" Foreground="#716B79" FontFamily="Consolas" FontSize="10" Margin="12,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource CapsuleButton}" Width="42" Height="32" Padding="0" Content="—" Click="MinimizeButton_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource CapsuleButton}" Width="42" Height="32" Padding="0" Content="×" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="20,0,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- progress rail -->
        <Border Grid.Column="0" CornerRadius="24" Background="#0D0C12" BorderBrush="#26222E" BorderThickness="1" Padding="18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="PERSONALIZE" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="Teach the core what you sound like." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,20"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
              <Border x:Name="Step0Card" Style="{StaticResource StepCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Step0Dot" Text="●" Foreground="#FF2D8B" Margin="0,0,10,0"/><StackPanel><TextBlock Text="01  WELCOME" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="What this setup changes" Foreground="#77717F" FontSize="10"/></StackPanel></StackPanel></Border>
              <Border x:Name="Step1Card" Style="{StaticResource StepCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Step1Dot" Text="●" Foreground="#514B57" Margin="0,0,10,0"/><StackPanel><TextBlock Text="02  AUDIO ROUTING" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="Clean words + raw events" Foreground="#77717F" FontSize="10"/></StackPanel></StackPanel></Border>
              <Border x:Name="Step2Card" Style="{StaticResource StepCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Step2Dot" Text="●" Foreground="#514B57" Margin="0,0,10,0"/><StackPanel><TextBlock Text="03  ROOM FLOOR" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="Learn fan / AC baseline" Foreground="#77717F" FontSize="10"/></StackPanel></StackPanel></Border>
              <Border x:Name="Step3Card" Style="{StaticResource StepCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Step3Dot" Text="●" Foreground="#514B57" Margin="0,0,10,0"/><StackPanel><TextBlock Text="04  TRAIN REACTIONS" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="Capture your own examples" Foreground="#77717F" FontSize="10"/></StackPanel></StackPanel></Border>
              <Border x:Name="Step4Card" Style="{StaticResource StepCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Step4Dot" Text="●" Foreground="#514B57" Margin="0,0,10,0"/><StackPanel><TextBlock Text="05  READY" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="Save setup + return to core" Foreground="#77717F" FontSize="10"/></StackPanel></StackPanel></Border>
            </StackPanel>

            <Border Grid.Row="2" CornerRadius="14" Background="#131119" BorderBrush="#2A2530" BorderThickness="1" Padding="12">
              <StackPanel>
                <TextBlock Text="LOCAL ONLY" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="Training WAVs stay under your local FURI//CORE AppData folder." Foreground="#817A88" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- page host -->
        <Border Grid.Column="2" CornerRadius="24" Background="#0E0D13" BorderBrush="#26222E" BorderThickness="1" Padding="34,28">
          <Grid>
            <!-- page 0 -->
            <Grid x:Name="PageWelcome">
              <StackPanel VerticalAlignment="Center" MaxWidth="650">
                <TextBlock Text="REACTION TRAINER" Foreground="#FF8A1F" FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="Make the Critter react to you — not to generic thresholds." FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,14"/>
                <TextBlock Text="This setup chooses separate Voice/Words and Event Sense microphones, measures your room noise, and records labeled examples of your normal speech, laughs, yawns and thoughtful hums." Foreground="#AAA4AF" FontSize="15" LineHeight="23" TextWrapping="Wrap"/>
                <Border CornerRadius="18" Background="#14121A" BorderBrush="#332936" BorderThickness="1" Padding="18" Margin="0,26,0,0">
                  <StackPanel>
                    <TextBlock Text="v0.7.3 PERSONAL CLASSIFIER" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="This build uses your recorded examples live. FURI//CORE compares Event Sense audio against your Normal, Laugh, Yawn, Hmm, Room/Noise and Keyboard samples. When enough samples exist, PERSONAL mode replaces the old event heuristics automatically." Foreground="#8F8996" TextWrapping="Wrap" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- page 1 -->
            <Grid x:Name="PageRouting" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="AUDIO ROUTING" Foreground="#FF2D8B" FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="Give words a clean feed. Give reactions the real one." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,24"/>

                <TextBlock Text="VOICE / WORD CORE" Foreground="#C4BEC9" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="Krisp is fine here. This feed drives normal talking and Vosk phrase triggers." Foreground="#7F7886" FontSize="11" Margin="0,5,0,7"/>
                <ComboBox x:Name="SetupVoiceMicComboBox" MaxDropDownHeight="280">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#F7F5FA" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="EVENT SENSE" Foreground="#C4BEC9" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Margin="0,24,0,0"/>
                <TextBlock Text="Use the raw physical mic here. Laughs, yawns and hums need the sounds noise suppression tends to remove." Foreground="#7F7886" FontSize="11" Margin="0,5,0,7" TextWrapping="Wrap"/>
                <ComboBox x:Name="SetupEventMicComboBox" MaxDropDownHeight="280">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#F7F5FA" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <Border CornerRadius="14" Background="#121018" BorderBrush="#2C2732" BorderThickness="1" Padding="14" Margin="0,22,0,0">
                  <TextBlock x:Name="RoutingHintText" Text="Recommended: Voice/Words = Krisp • Event Sense = raw microphone" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Grid>

            <!-- page 2 -->
            <Grid x:Name="PageRoom" Visibility="Collapsed">
              <StackPanel VerticalAlignment="Center" MaxWidth="650">
                <TextBlock Text="ROOM FLOOR" Foreground="#FF2D8B" FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="Let the raw mic hear your room before it tries to hear you." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,18"/>
                <TextBlock Text="Stay quiet for five seconds. Leave the fan or AC exactly how you normally use it. FURI//CORE will measure the baseline and suggest a more realistic voice threshold." Foreground="#9F99A5" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>

                <Border CornerRadius="20" Background="#121018" BorderBrush="#2C2732" BorderThickness="1" Padding="22" Margin="0,28,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="AMBIENT SIGNAL" Foreground="#C3BEC9" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                      <TextBlock x:Name="RoomDbText" Grid.Column="1" Text="— dB" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="12"/>
                    </Grid>
                    <Grid Width="540" Height="10" Background="#25212B" Margin="0,16,0,10" HorizontalAlignment="Left">
                      <Border x:Name="RoomProgressFill" HorizontalAlignment="Left" Width="0" Background="#FF2D8B"/>
                    </Grid>
                    <TextBlock x:Name="NoiseFloorText" Text="noise floor • not calibrated" Foreground="#817A88" FontFamily="Consolas" FontSize="10"/>
                    <Button x:Name="CalibrateRoomButton" Style="{StaticResource CapsuleButton}" Content="CALIBRATE ROOM • 5 SEC" Click="CalibrateRoomButton_Click" Margin="0,18,0,0" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- page 3 -->
            <Grid x:Name="PageTraining" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="TRAIN REACTIONS" Foreground="#FF2D8B" FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="Give FURI//CORE examples of you." FontSize="30" FontWeight="SemiBold" Margin="0,10,0,6"/>
                <TextBlock Text="Use your Event Sense / raw mic. Record natural examples — especially subtle laughs and real yawns." Foreground="#918A97" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <StackPanel Margin="0,0,8,0">
                  <Border Style="{StaticResource TrainingCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="NORMAL SPEECH" FontWeight="Bold"/><TextBlock Text="Talk casually for a few seconds. These are important negative examples." Foreground="#7F7886" FontSize="10" Margin="0,4,0,0"/><TextBlock x:Name="NormalCountText" Text="0 / 4 samples" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                      <Button x:Name="NormalRecordButton" Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="RECORD" Tag="Normal|5" Click="TrainingRecordButton_Click" MinWidth="110"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource TrainingCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="LAUGH" FontWeight="Bold"/><TextBlock Text="Mix subtle chuckles, normal laughs and one bigger laugh." Foreground="#7F7886" FontSize="10" Margin="0,4,0,0"/><TextBlock x:Name="LaughCountText" Text="0 / 5 samples" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                      <Button x:Name="LaughRecordButton" Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="RECORD" Tag="Laugh|4" Click="TrainingRecordButton_Click" MinWidth="110"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource TrainingCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="YAWN" FontWeight="Bold"/><TextBlock Text="Record real or natural-feeling yawns. Don't force a short fake 'ahh'." Foreground="#7F7886" FontSize="10" Margin="0,4,0,0"/><TextBlock x:Name="YawnCountText" Text="0 / 3 samples" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                      <Button x:Name="YawnRecordButton" Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="RECORD" Tag="Yawn|7" Click="TrainingRecordButton_Click" MinWidth="110"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource TrainingCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="THINKING / HMM" FontWeight="Bold"/><TextBlock Text="Give a few normal thoughtful 'hmmm...' sounds at different lengths." Foreground="#7F7886" FontSize="10" Margin="0,4,0,0"/><TextBlock x:Name="HmmCountText" Text="0 / 5 samples" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                      <Button x:Name="HmmRecordButton" Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="RECORD" Tag="Hmm|4" Click="TrainingRecordButton_Click" MinWidth="110"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource TrainingCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="ROOM / NOISE" FontWeight="Bold"/><TextBlock Text="No talking. Let the fan / AC / room ambience run normally. Keep deliberate keyboard typing for the separate Keyboard / Desk category." Foreground="#7F7886" FontSize="10" Margin="0,4,0,0"/><TextBlock x:Name="NoiseCountText" Text="0 / 2 samples" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                      <Button x:Name="NoiseRecordButton" Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="RECORD" Tag="Noise|5" Click="TrainingRecordButton_Click" MinWidth="110"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource TrainingCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="KEYBOARD / DESK NOISE" FontWeight="Bold"/><TextBlock Text="Type normally, click the mouse, and make the little desk sounds that were falsely triggering Laugh." Foreground="#7F7886" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="KeyboardCountText" Text="0 / 3 samples" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                      <Button x:Name="KeyboardRecordButton" Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="RECORD" Tag="Keyboard|6" Click="TrainingRecordButton_Click" MinWidth="110"/>
                    </Grid>
                  </Border>
                  <Grid Margin="0,4,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TrainingStatusText" Text="ready to record" Foreground="#807987" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="OPEN DATA FOLDER" Click="OpenTrainingFolderButton_Click" Padding="12,7"/></Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- page 4 -->
            <Grid x:Name="PageFinish" Visibility="Collapsed">
              <StackPanel VerticalAlignment="Center" MaxWidth="650">
                <TextBlock Text="READY" Foreground="#FF8A1F" FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="Your reaction profile has a baseline." FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,14"/>
                <TextBlock x:Name="FinishSummaryText" Text="Training summary" Foreground="#A49EAA" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                <Border CornerRadius="18" Background="#14121A" BorderBrush="#332936" BorderThickness="1" Padding="18" Margin="0,24,0,0">
                  <StackPanel>
                    <TextBlock Text="WHAT HAPPENS NOW" Foreground="#FF2D8B" FontFamily="Consolas" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Text="Your saved examples are now used by the live personalized classifier. If the training set is incomplete, FURI//CORE safely falls back to Generic mode. Add Keyboard / Desk samples whenever typing or clicks resemble laughter." Foreground="#8F8996" TextWrapping="Wrap" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- footer nav -->
      <Grid Grid.Row="2" Margin="24,12,24,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Style="{StaticResource CapsuleButton}" Content="BACK" Click="BackButton_Click" Width="110" IsEnabled="False"/>
        <TextBlock x:Name="FooterStatusText" Grid.Column="1" Text="setup is local • nothing is uploaded" Foreground="#625C69" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="GenericModeButton" Style="{StaticResource CapsuleButton}" Content="USE GENERIC MODE" Click="GenericModeButton_Click" Margin="0,0,10,0"/>
          <Button x:Name="NextButton" Style="{StaticResource CapsuleButton}" Content="GET STARTED" Click="NextButton_Click" Width="140" Background="#251421" BorderBrush="#FF2D8B"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
