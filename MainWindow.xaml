<Window x:Class="FuriXeus.Tuber.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuriXeus Tuber"
        Icon="Assets/FuriCore.ico"
        Width="1240" Height="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Border CornerRadius="30" Background="#09090D" BorderBrush="#24212D" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.65"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="82"/>
      </Grid.RowDefinitions>

      <!-- top rail -->
      <Grid Grid.Row="0" Margin="24,0,18,0" Background="Transparent" Cursor="SizeAll">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5" Background="#FF2D8B" Margin="0,0,10,0"><Border.Effect><DropShadowEffect Color="#FF2D8B" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/></Border.Effect></Border>
          <TextBlock Text="FURI//CORE" FontSize="18" FontWeight="Bold"/>
          <TextBlock x:Name="BuildVersionText" Text="v0.7.3 • PERSONAL CLASSIFIER" Foreground="#6E6977" FontSize="11" FontWeight="SemiBold" Margin="12,3,0,0"/>
        </StackPanel>

        <Border Grid.Column="1" CornerRadius="18" Background="#121119" BorderBrush="#292632" BorderThickness="1" Padding="14,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="CoreStatusDot" Width="7" Height="7" Fill="#5B5663" Margin="0,0,8,0"/>
            <TextBlock x:Name="CoreStatusText" Text="CORE IDLE" FontFamily="Consolas" FontSize="11" Foreground="#B3AFB9"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="TrainerButton" Style="{StaticResource CapsuleButton}" Width="88" Height="34" Padding="0" Content="TRAINER" Click="TrainerButton_Click" Margin="0,0,8,0"/>
          <Button x:Name="DebugLogButton" Style="{StaticResource CapsuleButton}" Width="112" Height="34" Padding="0" Content="DEBUG OFF" Click="DebugLogButton_Click" Margin="0,0,8,0"/>
          <Button x:Name="OpenLogsButton" Style="{StaticResource CapsuleButton}" Width="70" Height="34" Padding="0" Content="LOGS" Click="OpenLogsButton_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource CapsuleButton}" Width="42" Height="34" Padding="0" Content="—" Click="MinimizeButton_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource CapsuleButton}" Width="42" Height="34" Padding="0" Content="×" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>

      <!-- body -->
      <Grid Grid.Row="1" Margin="20,4,20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>

        <!-- REACTION ORBIT: intentionally not a traditional nav/sidebar layout -->
        <Grid Grid.Column="0">
          <Canvas Width="820" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="500" Height="500" Canvas.Left="160" Canvas.Top="42" Stroke="#2A2631" StrokeThickness="1" StrokeDashArray="2 8">
              <Ellipse.RenderTransform><RotateTransform x:Name="OrbitRotateA" CenterX="250" CenterY="250"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="430" Height="430" Canvas.Left="195" Canvas.Top="77" Stroke="#4D263E" StrokeThickness="1.5" StrokeDashArray="1 12">
              <Ellipse.RenderTransform><RotateTransform x:Name="OrbitRotateB" CenterX="215" CenterY="215"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="PulseRingOuter" Width="390" Height="390" Canvas.Left="215" Canvas.Top="97" Stroke="#FF2D8B" StrokeThickness="2" Opacity="0.18"/>
            <Ellipse x:Name="PulseRingInner" Width="350" Height="350" Canvas.Left="235" Canvas.Top="117" Stroke="#FF8A1F" StrokeThickness="1.5" Opacity="0.12"/>

            <Border Width="340" Height="340" Canvas.Left="240" Canvas.Top="122" CornerRadius="170" Background="#0D0C12" BorderBrush="#302A36" BorderThickness="1">
              <Grid>
                <Ellipse Margin="22" Stroke="#17141C" StrokeThickness="24"/>
                <Image x:Name="AvatarImage" Width="310" Height="310" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>

            <Border Width="250" Height="82" Canvas.Left="285" Canvas.Top="446" CornerRadius="18" Background="#0C0B10" BorderBrush="#2E2934" BorderThickness="1" Padding="18,10">
              <StackPanel>
                <TextBlock x:Name="CurrentStateText" Text="IDLE" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"/>
                <TextBlock x:Name="CurrentReasonText" Text="idle" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="#817B88" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <!-- orbit nodes -->
            <Button x:Name="ThinkingNode" Style="{StaticResource StateNode}" Tag="thinking" Canvas.Left="98" Canvas.Top="108" Click="StateNode_Click"><StackPanel><TextBlock Text="THINKING" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="HUM" HorizontalAlignment="Center" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="ShockedNode" Style="{StaticResource StateNode}" Tag="shocked" Canvas.Left="606" Canvas.Top="108" Click="StateNode_Click"><StackPanel><TextBlock Text="SHOCKED" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="WHAT?" HorizontalAlignment="Center" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="DeadpanNode" Style="{StaticResource StateNode}" Tag="deadpan" Canvas.Left="675" Canvas.Top="252" Click="StateNode_Click"><StackPanel><TextBlock Text="DEADPAN" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="BRUH" HorizontalAlignment="Center" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="HypeNode" Style="{StaticResource StateNode}" Tag="hype" Canvas.Left="590" Canvas.Top="420" Click="StateNode_Click"><StackPanel><TextBlock Text="HYPE" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="LET'S GO" HorizontalAlignment="Center" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="RageNode" Style="{StaticResource StateNode}" Tag="rage" Canvas.Left="352" Canvas.Top="532" Click="StateNode_Click"><StackPanel><TextBlock Text="RAGE" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="OVERRIDE" HorizontalAlignment="Center" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="LaughNode" Style="{StaticResource StateNode}" Tag="laugh" Canvas.Left="115" Canvas.Top="420" Click="StateNode_Click"><StackPanel><TextBlock Text="LAUGH" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="BURST" HorizontalAlignment="Center" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="SleepyNode" Style="{StaticResource StateNode}" Tag="sleepy" Canvas.Left="30" Canvas.Top="252" Click="StateNode_Click"><StackPanel><TextBlock Text="SLEEPY" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="YAWN" HorizontalAlignment="Center" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
            <Button x:Name="IdleNode" Style="{StaticResource StateNode}" Tag="idle" Canvas.Left="352" Canvas.Top="12" Click="StateNode_Click"><StackPanel><TextBlock Text="RESET" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/><TextBlock Text="IDLE" HorizontalAlignment="Center" Foreground="#8A8591" FontFamily="Consolas" FontSize="9"/></StackPanel></Button>
          </Canvas>
        </Grid>

        <!-- floating signal console -->
        <Grid Grid.Column="1" Margin="12,4,0,6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="178"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <Border Grid.Row="0" CornerRadius="24" Background="#111018" BorderBrush="#2A2631" BorderThickness="1" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="SIGNAL ROUTING" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>

              <Grid Margin="0,10,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="VOICE / WORDS" Foreground="#C3BEC9" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="KRISP OK" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="8.5"/>
              </Grid>
              <ComboBox x:Name="VoiceMicComboBox" Margin="0,0,0,9" MaxDropDownHeight="280" SelectionChanged="AudioRoute_SelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Foreground="#F7F5FA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="EVENT SENSE" Foreground="#C3BEC9" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="RAW MIC BEST" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="8.5"/>
              </Grid>
              <ComboBox x:Name="EventMicComboBox" Margin="0,0,0,7" MaxDropDownHeight="280" SelectionChanged="AudioRoute_SelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Foreground="#F7F5FA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock x:Name="RouteHintText" Text="voice → words/talk • event → hum/yawn/laugh" Foreground="#817B88" FontFamily="Consolas" FontSize="8.5" TextWrapping="Wrap" Margin="0,0,0,7"/>
              <TextBlock x:Name="SkinStatusText" Text="skin • BUILT-IN CHAOS CRITTER" Foreground="#8F8996" FontFamily="Consolas" FontSize="8.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
              <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="SkinFolderButton" Style="{StaticResource CapsuleButton}" Content="SKIN FOLDER" Click="SkinFolderButton_Click" Margin="0,0,4,4" Padding="5" FontSize="9"/>
                <Button Grid.Column="1" x:Name="AssetManagerButton" Style="{StaticResource CapsuleButton}" Content="ASSET MANAGER" Click="AssetManagerButton_Click" Margin="4,0,0,4" Padding="5" FontSize="9"/>
                <Button Grid.Row="1" x:Name="ReloadSkinButton" Style="{StaticResource CapsuleButton}" Content="RELOAD" Click="ReloadSkinButton_Click" Margin="0,4,4,0" Padding="5" FontSize="9"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="DefaultSkinButton" Style="{StaticResource CapsuleButton}" Content="DEFAULT ART" Click="DefaultSkinButton_Click" Margin="4,4,0,0" Padding="5" FontSize="9"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="ArmButton" Style="{StaticResource CapsuleButton}" Content="ARM CORE" Click="ArmButton_Click" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="OUTPUT" Click="OverlayButton_Click" Margin="6,0,0,0"/>
              </Grid>
              <TextBlock x:Name="MicErrorText" Text="" Foreground="#FF6D8B" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" CornerRadius="24" Background="#111018" BorderBrush="#2A2631" BorderThickness="1" Padding="18" Margin="0,0,0,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="VOICE SCOPE" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="DbText" Grid.Column="1" Text="-∞ dB" FontFamily="Consolas" Foreground="#C3BEC9" FontSize="11"/>
              </Grid>
              <Canvas Grid.Row="1" x:Name="WaveCanvas" Height="92" Margin="0,8,0,4" ClipToBounds="True">
                <Line X1="0" X2="310" Y1="46" Y2="46" Stroke="#292530" StrokeThickness="1"/>
                <Polyline x:Name="WaveformLine" Stroke="#FF2D8B" StrokeThickness="2" StrokeLineJoin="Round"/>
              </Canvas>
              <TextBlock x:Name="TranscriptText" Grid.Row="2" Text="heard: —" FontFamily="Consolas" Foreground="#8F8996" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" CornerRadius="24" Background="#111018" BorderBrush="#2A2631" BorderThickness="1" Padding="20">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="EVENT SENSE • RAW MIC" Foreground="#FF2D8B" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ModelStatusText" Grid.Column="1" Text="MODEL CHECK" Foreground="#837D8A" FontFamily="Consolas" FontSize="10"/></Grid>
              <TextBlock x:Name="WordHealthText" Text="word core • waiting" Foreground="#8F8996" FontFamily="Consolas" FontSize="8.5" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" ToolTip="Frames received and recognition results. Useful when trigger words are not firing."/>
              <TextBlock x:Name="EventSignalText" Text="raw mic • waiting • classifier decides reactions" Foreground="#6F6977" FontFamily="Consolas" FontSize="8.5" Margin="0,4,0,0"/>

              <TextBlock x:Name="HumSenseText" Text="HUM / THINKING  0%" Foreground="#A8A3AE" FontFamily="Consolas" FontSize="10" Margin="0,18,0,5"/>
              <Grid Height="7" Background="#24212B"><Border x:Name="HumBar" HorizontalAlignment="Left" Width="0" Background="#FF8A1F"/></Grid>
              <TextBlock x:Name="YawnSenseText" Text="YAWN / SLEEPY  0%" Foreground="#A8A3AE" FontFamily="Consolas" FontSize="10" Margin="0,13,0,5"/>
              <Grid Height="7" Background="#24212B"><Border x:Name="YawnBar" HorizontalAlignment="Left" Width="0" Background="#FF2D8B"/></Grid>
              <TextBlock x:Name="LaughSenseText" Text="LAUGH / BURST  0%" Foreground="#A8A3AE" FontFamily="Consolas" FontSize="10" Margin="0,13,0,5"/>
              <Grid Height="7" Background="#24212B"><Border x:Name="LaughBar" HorizontalAlignment="Left" Width="0" Background="#FF8A1F"/></Grid>

              <TextBlock Text="TRIGGER LEAD" Foreground="#A8A3AE" FontFamily="Consolas" FontSize="10" Margin="0,18,0,0"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Slider x:Name="TriggerLeadSlider" Minimum="0" Maximum="450" Value="300" ValueChanged="TuningSlider_ValueChanged"/><TextBlock x:Name="TriggerLeadValue" Grid.Column="1" Text="300 ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#C3BEC9" FontFamily="Consolas" FontSize="10"/></Grid>

              <TextBlock Text="TALK THRESHOLD" Foreground="#A8A3AE" FontFamily="Consolas" FontSize="10"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Slider x:Name="ThresholdSlider" Minimum="-65" Maximum="-18" Value="-42" ValueChanged="TuningSlider_ValueChanged"/><TextBlock x:Name="ThresholdValue" Grid.Column="1" Text="-42 dB" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#C3BEC9" FontFamily="Consolas" FontSize="10"/></Grid>

              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="InstallModelButton" Style="{StaticResource CapsuleButton}" Content="INSTALL WORD CORE" Click="InstallModelButton_Click" Margin="0,0,6,0"/><Button Grid.Column="1" Style="{StaticResource CapsuleButton}" Content="SAVE TUNING" Click="SaveTuningButton_Click" Margin="6,0,0,0"/></Grid>
              <TextBlock x:Name="InstallProgressText" Text="" Foreground="#817B88" FontFamily="Consolas" FontSize="9" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- event tape -->
      <Grid Grid.Row="2" Margin="24,10,24,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="REACTION TAPE" Foreground="#FF8A1F" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock Text="latest event first" Foreground="#5E5965" FontFamily="Consolas" FontSize="9" Margin="0,3,0,0"/></StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="EventTapePanel" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
